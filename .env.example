# Variáveis de ambiente — A Portamóvel
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env no repositório.

# URL pública do projeto Supabase (visível no browser — não é um segredo)
NUXT_PUBLIC_SUPABASE_URL=

# Chave publishable do Supabase (pública por definição — não concede acesso admin)
NUXT_PUBLIC_SUPABASE_KEY=
