# Variáveis de ambiente — A Portamóvel
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env no repositório.

# Supabase (Público / Client-side)
NUXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sua-chave-publica-anon

# Supabase (Privado / Server-only)
SUPABASE_SECRET_KEY=sua-chave-secreta-service-role

# PostHog Analytics
NUXT_PUBLIC_POSTHOG_KEY=phc_seu_posthog_key
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=phx_sua_chave_pessoal
POSTHOG_PROJECT_ID=000000

# Cloudflare Turnstile
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1,www.aportamovel.com.br,aportamovel.com.br

# Políticas & Conformidade
LEAD_PRIVACY_NOTICE_VERSION=2026-08

# Cloudflare R2 (Storage de Mídia e Catálogo — Conjunto Canônico)
R2_ACCOUNT_ID=seu_cloudflare_account_id
R2_ACCESS_KEY_ID=sua_r2_access_key_id
R2_SECRET_ACCESS_KEY=sua_r2_secret_access_key
R2_BUCKET_NAME=nome_do_bucket
R2_PUBLIC_BASE_URL=https://pub-seu-id.r2.dev

# Cron / Tarefas Periódicas (Opcional)
CRON_SECRET=seu_cron_secret_aleatorio

# Gestão de Administradores (Privado / Server-only)
ADMIN_AUTH_CONFIRM_URL=http://localhost:3000/auth/confirm
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.aportamovel.com.br,https://aportamovel.com.br
ADMIN_IDEMPOTENCY_HMAC_SECRET=segredo_aleatorio_seguro_minimo_32_bytes
